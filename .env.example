# Docker Compose reads this file after you copy it to .env.
# Generate your own secret: python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
DJANGO_SECRET_KEY=replace-with-a-random-secret-before-starting-docker
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# 0 supports a local HTTP Docker preview. Use 1 behind HTTPS in production.
DJANGO_COOKIE_SECURE=0
ALLOW_REGISTRATION=1

